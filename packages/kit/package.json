{
  "name": "@anyglade/kit",
  "version": "0.4.0",
  "description": "React UI kit on HeroUI v3 and Tailwind CSS v4: tokens, layout, motion, lint rules and ready patterns.",
  "keywords": [
    "design-system",
    "heroui",
    "react",
    "tailwindcss",
    "ui-kit"
  ],
  "homepage": "https://github.com/mywwave/anyglade-kit#readme",
  "bugs": "https://github.com/mywwave/anyglade-kit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mywwave/anyglade-kit.git",
    "directory": "packages/kit"
  },
  "bin": {
    "anyglade-kit": "./bin/anyglade-kit.mjs"
  },
  "files": [
    "assets",
    "dist",
    "oxlint",
    "styles",
    "NOTICE",
    "LICENSE",
    "bin",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./oxlint": "./oxlint/index.mjs",
    "./styles.css": "./styles/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "vp pack && bun scripts/copy-skill.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "postinstall": "node bin/anyglade-kit.mjs postinstall"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gravity-ui/icons": "^2.23.1",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  }
}
